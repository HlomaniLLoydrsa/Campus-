# Turso (cloud SQLite / libSQL) — required in production (set these in Netlify → Site settings → Environment variables)
# Get them from https://turso.tech after creating a database.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-long-auth-token-here

# Notes:
# - If these are NOT set, the app falls back to a local file database (file:campus.db) for development.
# - Netlify Blobs (used for image uploads) works automatically on Netlify with no extra config.
