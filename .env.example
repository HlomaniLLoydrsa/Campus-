# ─────────────────────────────────────────────────────────────
# VYBE — Environment variables (copy to .env.local for local dev,
# and set these in your host's dashboard for production)
# NEVER commit real values. .env and .env*.local are gitignored.
# ─────────────────────────────────────────────────────────────

# Turso (cloud SQLite / libSQL) — REQUIRED in production.
# Create a free database at https://turso.tech, then copy its URL + token.
# Set these in your host (Netlify/Vercel/Render) → Environment variables.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-long-auth-token-here

# Public base URL of the deployed app (used for absolute links / PWA / share URLs).
# Example: https://vybe.netlify.app  — no trailing slash.
NEXT_PUBLIC_APP_URL=https://your-app-domain.example

# Secret used to sign the session cookie. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production. If unset locally, a dev-only default is used.
AUTH_SECRET=change-me-to-a-long-random-string

# ─────────────────────────────────────────────────────────────
# Email delivery (password reset links) — via Resend (https://resend.com)
# Without these, the "Forgot password" flow still works but no email is sent
# (the UI shows a "not configured" note). To enable real emails:
#   1. Create a free Resend account and add an API key below.
#   2. For a custom From address, verify your domain in Resend and add the
#      DNS records they give you (at domains.co.za). Until then you can send
#      test emails to your OWN address using the default onboarding sender.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sender. Before verifying a domain, use: onboarding@resend.dev
EMAIL_FROM=VYBE <no-reply@vybee.site>

# Notes:
# - If TURSO_* are NOT set, the app falls back to a local file database (file:campus.db) for development.
# - Netlify Blobs (used for image uploads) works automatically on Netlify with no extra config.
# - RESEND_API_KEY / EMAIL_FROM are read at runtime, so set them in Netlify →
#   Site settings → Environment variables, then redeploy.
